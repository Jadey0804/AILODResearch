# Visual Studio 2015 user specific files
.vs/

# JetBrains Rider and IntelliJ-based IDEs
.idea/
*.sln.iml

# Local logs
*.log

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Local-only research materials
/Papers/
/ReadingNotes/

# Generated documentation artifacts
/Docs/_render/
/Docs/*.docx
/Docs/_build_ailod_mvp_doc.py
/Docs/_make_contact_sheets.py
/Docs/_render_with_word.ps1

# Local scratch artifacts
/tmp/

# Local document drafts and generated review exports.
# Existing tracked files remain tracked; these rules prevent new working copies
# and generated Office documents from being added accidentally.
/Deliverables/**/*.doc
/Deliverables/**/*.docx
/outputs/**/*.doc
/outputs/**/*.docx
/outputs/**/*.xlsx
/outputs/**/*.inspect.ndjson
